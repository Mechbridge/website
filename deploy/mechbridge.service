# systemd unit for the Mechbridge website (Astro Node server).
# Install: sudo cp deploy/mechbridge.service /etc/systemd/system/ && sudo systemctl enable --now mechbridge
[Unit]
Description=Mechbridge International website
After=network.target

[Service]
Type=simple
User=mechbridge
WorkingDirectory=/var/www/mechbridge
EnvironmentFile=/etc/mechbridge.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning dist/server/entry.mjs
Restart=always
RestartSec=3
# Hardening. NoNewPrivileges is off on purpose: the staff portal runs the mailbox tool through
# one sudo rule (deploy/sudoers-mechbridge), which needs it. /etc and /usr stay read-only.
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/mechbridge
PrivateTmp=true

[Install]
WantedBy=multi-user.target
