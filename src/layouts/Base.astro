---
import { u, stripBase } from '../lib/url';
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/doto';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, offices, serves, servesShort } from '../data/site';

interface Props {
  title: string;
  description: string;
  glassNav?: boolean;
  og?: string; // share card slug in public/og/ (default: home)
  ogAlt?: string;
  noindex?: boolean;
  breadcrumbs?: [string, string][]; // [name, path] after Home
  jsonLd?: Record<string, unknown>[]; // extra schema.org nodes for this page
}
const { title, description, glassNav = false, og = 'home', ogAlt, noindex = false, breadcrumbs = [], jsonLd = [] } = Astro.props;
const DEMO = import.meta.env.PUBLIC_DEMO === '1';
// Canonical and share URLs always point at the production domain, even on a preview host.
const path = stripBase(Astro.url.pathname);
const canonical = new URL(path, site.url).href;
const fullTitle = title === site.name ? `${site.name} | MEP Consultants: HVAC, firefighting and plumbing engineering` : `${title} | ${site.name}`;
const ogImage = new URL(`/og/${og}.jpg`, site.url).href;
const robots = DEMO || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1';

const ORG_ID = `${site.url}/#organization`;
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': ORG_ID,
    name: site.name,
    legalName: site.company,
    url: site.url,
    logo: { '@type': 'ImageObject', url: `${site.url}/logo/mechbridge-512.png`, width: 512, height: 512 },
    image: `${site.url}/og/home.jpg`,
    email: site.connect,
    foundingLocation: { '@type': 'Place', name: 'Dubai, United Arab Emirates' },
    areaServed: serves.map((name) => ({ '@type': 'Country', name })),
    location: offices.map((o) => ({ '@type': 'Place', name: `${site.name}, ${o.city}`, address: { '@type': 'PostalAddress', addressLocality: o.city === 'India' ? undefined : o.city, addressCountry: o.country } })),
    knowsAbout: ['HVAC engineering', 'Firefighting engineering', 'Fire protection', 'Plumbing engineering', 'MEP design', 'Shop drawings', 'BOQ preparation', 'MEP cost estimation', 'Project management'],
    contactPoint: [
      { '@type': 'ContactPoint', contactType: 'sales', email: site.connect, areaServed: servesShort, availableLanguage: ['English'] },
      { '@type': 'ContactPoint', contactType: 'customer support', email: site.support, availableLanguage: ['English'] },
      { '@type': 'ContactPoint', contactType: 'human resources', email: site.careers, availableLanguage: ['English'] },
    ],
  },
  { '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url, name: site.name, publisher: { '@id': ORG_ID }, inLanguage: 'en' },
  {
    '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: fullTitle, description, inLanguage: 'en',
    isPartOf: { '@id': `${site.url}/#website` }, about: { '@id': ORG_ID }, primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 },
  },
];
if (breadcrumbs.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [['Home', '/'], ...breadcrumbs].map(([name, p], i) => ({ '@type': 'ListItem', position: i + 1, name, item: new URL(p, site.url).href })),
  });
}
graph.push(...jsonLd);
const ld = { '@context': 'https://schema.org', '@graph': graph };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={u('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
    <link rel="manifest" href={u('/site.webmanifest')} />
    <meta name="theme-color" content="#131E32" />
    <meta name="author" content={site.company} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt ?? `${title === site.name ? 'Mechbridge International MEP Consultants' : title}: share card`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt ?? fullTitle} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>
      document.documentElement.classList.add('js');
      setTimeout(function () { document.documentElement.classList.add('motion-ready'); }, 2500);
    </script>
    <style is:global>
      .js:not(.motion-ready) [data-enter] > * { opacity: 0; }
      @media (prefers-reduced-motion: reduce) { .js:not(.motion-ready) [data-enter] > * { opacity: 1; } }
    </style>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav glass={glassNav} />
    <slot name="outside" />
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <main id="main" tabindex="-1">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
