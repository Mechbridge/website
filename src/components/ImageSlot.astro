---
import { u } from '../lib/url';
// Image slot. Drop a file named <id>.webp (or .jpg / .png) into public/images/
// and it replaces the placeholder on the next build. The brief for every id is in IMAGES.md.
import fs from 'node:fs';
import path from 'node:path';
interface Props {
  id: string;
  ratio?: string; // CSS aspect-ratio, e.g. "4 / 5"
  alt: string;
  label?: string; // what the photo shows, printed on the placeholder
  class?: string;
  eager?: boolean;
  zoom?: boolean;
  speed?: number; // ScrollSmoother lag on the image inside its frame
}
const { id, ratio = '4 / 3', alt, label, class: cls = '', eager = false, zoom = false, speed } = Astro.props;
const dir = path.join(process.cwd(), 'public', 'images');
const file = ['webp', 'jpg', 'jpeg', 'png', 'avif'].map((e) => `${id}.${e}`).find((f) => fs.existsSync(path.join(dir, f)));
---
{file ? (
  <div class={`slot ${zoom ? 'slot--zoom' : ''} ${cls}`} style={`--ar:${ratio}`} data-reveal-img>
    <img src={u(`/images/${file}`)} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" data-speed={speed} />
  </div>
) : (
  <div class={`slot slot--ph ${cls}`} style={`--ar:${ratio}`} role="img" aria-label={`${alt} (image to come)`} data-reveal-img data-slot={id}>
    <span class="slot__cross" aria-hidden="true"></span>
    <span class="slot__ph" aria-hidden="true">
      <span class="slot__id">{id}</span>
      <span class="slot__meta">{ratio.replace(/\s/g, '')} · {label ?? alt}</span>
    </span>
  </div>
)}
