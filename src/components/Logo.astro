---
// Mechbridge International logo (skyscraper "M" monogram + MECHBRIDGE wordmark).
// Inline so it takes the ground's colour (currentColor): cream on navy/photo, red on cream.
// variant "full" = monogram + wordmark, "mark" = monogram only (the wordmark sits below y 746, outside that crop).
import inner from '../data/logo-inner.svg?raw';
interface Props { variant?: 'full' | 'mark'; class?: string; title?: string }
const { variant = 'full', class: cls = '', title = 'Mechbridge International' } = Astro.props;
const viewBox = variant === 'full' ? '140 130 1260 780' : '360 130 816 616';
---
<svg class={`logo ${variant === 'mark' ? 'logo--mark' : ''} ${cls}`} viewBox={viewBox} role="img" aria-label={title} xmlns="http://www.w3.org/2000/svg" set:html={inner} />
