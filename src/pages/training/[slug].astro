---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import Arrow from '../../components/Arrow.astro';
import { tracks, type Track } from '../../data/tracks';

export function getStaticPaths() {
  return tracks.map((t) => ({ params: { slug: t.slug }, props: { track: t } }));
}
const { track } = Astro.props as { track: Track };
const i = tracks.findIndex((t) => t.slug === track.slug);
const related = [tracks[(i + 1) % tracks.length], tracks[(i + 2) % tracks.length]];
---
<Base title={`${track.title} training`} description={`${track.title} training from Mechbridge MEP Consultants. ${track.short} Taught by engineers on live Dubai and Saudi projects.`}>
  <section class="th" data-enter aria-labelledby="th-h">
    <div class="wrap">
      <nav class="crumbs mono" aria-label="Breadcrumb" data-enter-item>
        <a href={u('/training')}>Training</a><span aria-hidden="true">/</span><span aria-current="page">{track.title}</span>
      </nav>
      <div class="th__grid">
        <div class="th__copy">
          <h1 id="th-h">{track.title}</h1>
          <p class="lede" data-enter-item>{track.lede}</p>
          <div class="btn-row" data-enter-item>
            <a class="btn" href="#enquire">Enquire about this track <Arrow /></a>
            <a class="btn btn--ghost" href="#modules">See the modules</a>
          </div>
        </div>
        <div class="tblock th__tb" data-enter-item>
          <div class="tblock__row"><span class="tblock__k">Sheet ref</span><span class="tblock__v mono">{track.code}</span></div>
          <div class="tblock__row"><span class="tblock__k">Modules</span><span class="tblock__v">{track.modules.length}</span></div>
          <div class="tblock__row"><span class="tblock__k">Duration</span><span class="tblock__v">To be confirmed</span></div>
          <div class="tblock__row"><span class="tblock__k">Formats</span><span class="tblock__v">Dubai · KSA · Online</span></div>
          <div class="tblock__row"><span class="tblock__k">Taught by</span><span class="tblock__v">Mechbridge MEP Consultants</span></div>
        </div>
      </div>
    </div>
    <div class="wrap th__img">
      <ImageSlot id={`${track.img}-wide`} ratio="21 / 9" alt={`${track.title} work in progress at Mechbridge`} label={`${track.title}: wide working shot`} eager />
    </div>
  </section>

  <section class="section g-cream theme-cream" aria-labelledby="who-h">
    <div class="wrap grid-12 who">
      <h2 id="who-h" class="who__h" data-split>Who this track is for.</h2>
      <ul class="who__list">
        {track.forWho.map((w) => <li>{w}</li>)}
      </ul>
    </div>
  </section>

  <section class="section g-navy" id="modules" aria-labelledby="mod-h">
    <div class="wrap grid-12 mod">
      <div class="mod__head">
        <h2 id="mod-h" data-split>What you'll work through.</h2>
        <ImageSlot id={`${track.img}-detail`} ratio="4 / 5" alt={`Close-up of ${track.title.toLowerCase()} drawings`} label={`${track.title}: drawing close-up`} />
      </div>
      <ol class="mod__list">
        {track.modules.map((m, n) => (
          <li>
            <span class="dot mod__n">{String(n + 1).padStart(2, '0')}</span>
            <div><h3>{m.title}</h3><p class="body">{m.detail}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section g-deep" aria-labelledby="out-h">
    <div class="wrap out">
      <div>
        <h2 id="out-h" class="out__h" data-split>What you hand in.</h2>
        <ul class="out__list">{track.deliverables.map((d) => <li>{d}</li>)}</ul>
      </div>
      <div class="out__side">
        <div>
          <h3 class="out__k">Codes you'll apply</h3>
          <ul class="chips">{track.codes.map((c) => <li>{c}</li>)}</ul>
        </div>
        <div>
          <h3 class="out__k">Tools</h3>
          <ul class="chips">{track.tools.map((c) => <li>{c}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section g-navy" id="enquire" aria-labelledby="enq-h">
    <div class="wrap grid-12 enq">
      <div class="enq__copy stack">
        <h2 id="enq-h" data-split>Ask about {track.title}.</h2>
        <p class="lede">We'll reply with the next start date, the format options and the fee for this track.</p>
        <div class="rel">
          <p class="mono rel__k">Engineers often pair it with</p>
          {related.map((r) => <a class="link" href={u(`/training/${r.slug}`)}>{r.title} <Arrow /></a>)}
        </div>
      </div>
      <div class="enq__form"><EnquiryForm id="track-form" topic="training" track={track.slug} submit="Send my enquiry" /></div>
    </div>
  </section>

  <a class="sticky-cta btn" href="#enquire">Enquire about this track</a>
</Base>

<style>
  .th { background: var(--navy-800); padding: calc(var(--nav-h) + clamp(32px, 4vw, 64px)) 0 clamp(56px, 7vw, 104px); }
  .crumbs { display: flex; gap: 10px; align-items: center; color: var(--navy-200); margin-bottom: 32px; }
  .crumbs a { color: var(--cream-300); text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  .crumbs a:hover { color: var(--red-300); }
  .th__grid { display: grid; grid-template-columns: 1.4fr .8fr; gap: clamp(32px, 5vw, 80px); align-items: end; }
  .th__copy { display: grid; gap: 28px; }
  .th h1 { font-size: clamp(3.2rem, 8vw, 8rem); }
  .th__tb .tblock__v { font-size: .9375rem; }
  .th__img { margin-top: clamp(48px, 6vw, 88px); }

  .who { align-items: start; }
  .who__h { grid-column: 1 / 6; }
  .who__list { grid-column: 7 / 13; list-style: none; margin: 0; padding: 0; }
  .who__list li { padding: 22px 0 22px 36px; border-top: 1px solid var(--cream-500); font-size: 1.1875rem; position: relative; }
  .who__list li:last-child { border-bottom: 1px solid var(--cream-500); }
  .who__list li::before { content: ""; position: absolute; left: 0; top: 34px; width: 18px; height: 2px; background: var(--red-500); }

  .mod { align-items: start; }
  .mod__head { grid-column: 1 / 6; display: grid; gap: 40px; position: sticky; top: 110px; }
  .mod__list { grid-column: 7 / 13; list-style: none; margin: 0; padding: 0; }
  .mod__list li { display: grid; grid-template-columns: 64px 1fr; gap: 16px; padding: 30px 0; border-top: var(--hair); }
  .mod__list li:last-child { border-bottom: var(--hair); }
  .mod__n { color: var(--red-300); font-size: 1.6rem; line-height: 1; }
  .mod__list h3 { margin-bottom: 8px; }

  .out { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
  .out__h { margin-bottom: 32px; }
  .out__list { list-style: none; margin: 0; padding: 0; counter-reset: o; }
  .out__list li { font-family: var(--f-display); font-variation-settings: "wdth" 80, "opsz" 48; font-weight: 700; font-size: clamp(1.5rem, 2.4vw, 2.2rem); line-height: 1.1; padding: 18px 0; border-top: var(--hair); }
  .out__side { display: grid; gap: 40px; padding-top: 12px; }
  .out__k { font-family: var(--f-mono); font-size: var(--t-micro); font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--navy-200); margin-bottom: 16px; font-variation-settings: normal; }

  .enq { align-items: start; }
  .enq__copy { grid-column: 1 / 6; --flow: 28px; }
  .enq__form { grid-column: 7 / 13; }
  .rel { display: grid; gap: 4px; padding-top: 12px; }
  .rel__k { color: var(--navy-200); font-size: var(--t-micro); text-transform: uppercase; letter-spacing: .1em; }

  .sticky-cta { display: none; }
  @media (max-width: 1099px) {
    .th__grid, .out { grid-template-columns: 1fr; }
    .mod__head { position: static; }
  }
  @media (max-width: 767px) {
    .sticky-cta { display: flex; position: fixed; left: 16px; right: 16px; bottom: max(16px, env(safe-area-inset-bottom)); z-index: 90; box-shadow: 0 16px 40px -12px rgb(8 13 23 / .7); }
    .th__img :global(.slot) { --ar: 4 / 3 !important; }
  }
</style>
