---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import FlutedGlass from '../../components/FlutedGlass.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import Arrow from '../../components/Arrow.astro';
import PayPartners from '../../components/PayPartners.astro';
import { course, compare, steps } from '../../data/course';
import { site, track } from '../../data/site';

const faqs = [
  ['Do I need work experience?', 'No. The course suits final-year students and fresh graduates in mechanical engineering, and working engineers who want to move into MEP design. A short skills check puts you at the right level.'],
  ['Is it one course or several?', 'One course. HVAC, firefighting and plumbing are taught together, the way they come together on a real drawing set.'],
  ['Who teaches it?', 'Engineers from Mechbridge International MEP Consultants who design these systems on current projects.'],
  ['Do I get a certificate?', 'Yes. Each certificate carries a unique code. Employers can check it on our verification page.'],
  ['Can I train while I work?', 'Yes. Sessions are scheduled around a working week, so most engineers train alongside their jobs.'],
  ['What does it cost and when does the next batch start?', 'Published batches are listed on this page with their start dates. Send an enquiry and we will reply with the fee and the current schedule.'],
  ['Can I pay in instalments?', 'Yes. You can pay the course fee in instalments with Tabby or Tamara.'],
];
const gallery = [
  { id: 'work-heatload', ratio: '4 / 3', alt: 'Heat load workbook on a laptop beside a printed floor plan', label: 'Heat load workbook + floor plan' },
  { id: 'work-model', ratio: '4 / 5', alt: 'Engineers reviewing a 3D model of a pump room on a screen', label: 'Pump room model on screen' },
  { id: 'work-markup', ratio: '4 / 5', alt: 'Firefighting layout with red review mark-ups', label: 'Layout with review mark-ups' },
  { id: 'work-sld', ratio: '4 / 3', alt: 'Schematic drawings pinned to a wall', label: 'Schematics on a pin-up wall' },
  { id: 'work-site', ratio: '16 / 9', alt: 'Site visit in hard hats looking at exposed ductwork', label: 'Site visit, exposed ductwork' },
];
const trainingLd = [
  {
    '@type': 'Course',
    name: course.title,
    description: course.lede,
    url: 'https://mechbridgegroup.com/training',
    image: 'https://mechbridgegroup.com/og/training.jpg',
    provider: { '@id': 'https://mechbridgegroup.com/#organization' },
    teaches: course.modules.map((m) => m.title),
    syllabusSections: course.modules.map((m) => ({ '@type': 'Syllabus', name: m.title, description: m.items.join('; ') })),
    educationalCredentialAwarded: 'Mechbridge International MEP Consultants certificate (verifiable online)',
    inLanguage: 'en',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---
<Base
  og="training"
  breadcrumbs={[['Training', '/training']]}
  jsonLd={trainingLd}
  title="Professional MEP Engineering Training"
  description="One course in HVAC, firefighting and plumbing design, taught by engineers from Mechbridge International MEP Consultants to more than 3,000 students so far. Live, instructor-led sessions, a verifiable certificate, and instalments with Tabby or Tamara."
>
  <section class="t-hero" data-enter aria-labelledby="t-hero-h">
    <div class="wrap t-hero__grid">
      <div class="t-hero__copy">
        <h1 id="t-hero-h">{course.title}</h1>
        <p class="lede" data-enter-item>{course.lede}</p>
        <div class="btn-row" data-enter-item>
          <a class="btn" href="#enquire">Enquire about the next batch <Arrow /></a>
          <a class="btn btn--ghost" href="#modules">See what the course covers</a>
        </div>
      </div>
      <div class="t-hero__media" data-enter-item>
        <ImageSlot id="training-hero" ratio="4 / 5" alt="Instructor explaining a large printed MEP drawing to a small group" label="Instructor at a printed MEP drawing" eager />
        <div class="t-hero__block glass">
          <div class="tblock__row"><span class="tblock__k">Students trained</span><span class="tblock__v">{track.students}</span></div>
          <div class="tblock__row"><span class="tblock__k">Modules</span><span class="tblock__v">{course.modules.map((m) => m.title).join(' · ')}</span></div>
          <div class="tblock__row"><span class="tblock__k">Sessions</span><span class="tblock__v">Live, instructor-led</span></div>
          <div class="tblock__row"><span class="tblock__k">Certificate</span><a class="tblock__v t-verify" href={u('/verify')}>Verifiable online</a></div>
          <div class="tblock__row"><span class="tblock__k">Payment</span><span class="tblock__v">Instalments with Tabby or Tamara</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section g-red theme-red" aria-labelledby="t-red-h">
    <div class="wrap red">
      <h2 id="t-red-h" class="red__h" data-split>Not academic. Taught from live projects.</h2>
      <div class="red__row">
        <ImageSlot id="training-site" ratio="3 / 2" alt="Engineer in a hard hat checking ductwork on a construction site" label="Engineer on site, hard hat, ductwork" />
        <ul class="red__list">
          <li><strong>Working engineers teach.</strong> Instructors come from our consultancy, where they design these systems for clients.</li>
          <li><strong>Real drawing sets.</strong> You work on project-style sets drawn from the building types we design in the GCC.</li>
          <li><strong>Reviewed like our own team.</strong> Your drawings go through the same design review our engineers face.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section g-navy" id="modules" aria-labelledby="mod-h">
    <div class="wrap">
      <div class="mod-head">
        <h2 id="mod-h" data-split>Three modules, one drawing set.</h2>
        <p class="body">More than {track.students.replace('+', '')} students have trained with us so far. Each module ends with drawings and calculations you hand in for review. By the last one you have a complete MEP set for one building.</p>
      </div>
      <ol class="mods">
        {course.modules.map((m) => (
          <li class="mod">
            <span class="mod__code mono">{m.code}</span>
            <h3>{m.title}</h3>
            <ul>{m.items.map((it) => <li>{it}</li>)}</ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section g-cream theme-cream" aria-labelledby="t-cmp-h">
    <div class="wrap grid-12 cmp">
      <div class="cmp__head">
        <h2 id="t-cmp-h" data-split>What changes when working engineers teach.</h2>
        <p class="lede">An academic course teaches the theory. We teach the job: codes as authorities apply them, the details contractors ask about, and the comments that come back from Civil Defence.</p>
      </div>
      <table class="compare cmp__table">
        <caption class="sr-only">How Mechbridge training compares with a typical course</caption>
        <thead><tr><th scope="col"><span class="sr-only">Topic</span></th><th scope="col">Typical course</th><th scope="col">Mechbridge</th></tr></thead>
        <tbody>{compare.map(([k, a, b]) => <tr><th scope="row">{k}</th><td>{a}</td><td>{b}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="section g-deep" id="batches" aria-labelledby="b-h">
    <div class="wrap">
      <div class="mod-head">
        <h2 id="b-h" data-split>Upcoming batches.</h2>
        <p class="body">Dates are published here as soon as each batch is confirmed.</p>
      </div>
      <div class="posts posts--grid" data-batches></div>
    </div>
  </section>

  <section class="section g-navy" aria-labelledby="t-j-h">
    <div class="wrap grid-12 jr">
      <div class="jr__head">
        <h2 id="t-j-h" data-split>From first enquiry to certificate.</h2>
        <ImageSlot id="training-review" ratio="4 / 3" alt="Drawings presented on a screen during a design review" label="Design review at a screen" />
      </div>
      <ol class="jr__steps">
        {steps.map(([t, d], i) => (
          <li><span class="dot jr__n">{String(i + 1).padStart(2, '0')}</span><div><h3>{t}</h3><p class="body">{d}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section g-deep" aria-labelledby="t-g-h">
    <div class="wrap">
      <div class="gl-head">
        <h2 id="t-g-h" data-split>The work you leave with.</h2>
        <FlutedGlass class="gl-art" ratio="16 / 7" rib={16} left="Portfolio" right="Module by module" />
      </div>
      <div class="gl">
        {gallery.map((g, i) => <div class={`gl__i gl__i--${i + 1}`}><ImageSlot id={g.id} ratio={g.ratio} alt={g.alt} label={g.label} /></div>)}
      </div>
    </div>
  </section>

  <section class="section g-red theme-red" aria-labelledby="t-int-h">
    <div class="wrap int">
      <h2 id="t-int-h" data-split>Still studying? Take the internship package.</h2>
      <div class="stack">
        <p class="lede">The GCC-Ready Internship Package adds supervised project work, a portfolio review and interview preparation to the full course.</p>
        <a class="btn" href={u('/internships')}>See the internship package <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="section g-paper theme-paper" aria-labelledby="t-q-h">
    <div class="wrap grid-12 faq">
      <h2 id="t-q-h" class="faq__h" data-split>Questions engineers ask us.</h2>
      <div class="faq__list">
        {faqs.map(([q, a]) => (
          <details><summary><span>{q}</span><span class="faq__ic" aria-hidden="true"></span></summary><p class="body">{a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <section class="section g-navy" id="enquire" aria-labelledby="t-e-h">
    <div class="wrap grid-12 enq">
      <div class="enq__copy stack">
        <h2 id="t-e-h" data-split>Ask about the next batch.</h2>
        <p class="lede">Tell us your background and when you would like to start. The training team replies with the next batch dates and the fee.</p>
        <div class="tblock enq__tb">
          <div class="tblock__row"><span class="tblock__k">Training</span><a class="tblock__v link" href={`mailto:${site.connect}`}>{site.connect}</a></div>
          <div class="tblock__row"><span class="tblock__k">Certificates</span><a class="tblock__v link" href={u('/verify')}>Verify a certificate</a></div>
        </div>
        <PayPartners class="enq__pay" />
      </div>
      <div class="enq__form">
        <p class="picked" data-picked hidden>Enquiring about <strong data-ref-title></strong> <button type="button" data-unpick>Any batch instead</button></p>
        <EnquiryForm id="training-form" type="training" types={['training']} submit="Send my enquiry" />
      </div>
    </div>
  </section>
</Base>

<script>
  import { mountPostings, pickInForm, clearPick } from '../../scripts/postings';
  const note = document.querySelector<HTMLElement>('[data-picked]');
  mountPostings({
    kind: 'training',
    root: document.querySelector<HTMLElement>('[data-batches]')!,
    empty: 'No batch dates are published yet. Send an enquiry and we will tell you when the next one starts.',
    action: 'Enquire about this batch',
    onPick: (p) => pickInForm('training-form', p, note),
  });
  document.querySelector('[data-unpick]')?.addEventListener('click', () => clearPick('training-form', note));
</script>

<style>
  .t-hero { background: var(--navy-800); padding: calc(var(--nav-h) + clamp(40px, 6vw, 88px)) 0 clamp(64px, 8vw, 120px); }
  .t-hero__grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(32px, 5vw, 88px); align-items: end; }
  .t-hero__copy { display: grid; gap: 28px; padding-bottom: 12px; }
  .t-hero h1 { max-width: 13ch; font-size: clamp(2.8rem, 6.4vw, 6.4rem); }
  .t-hero__media { position: relative; }
  .t-hero__block { position: absolute; left: -32px; bottom: 32px; width: min(380px, 92%); padding: 4px 0; }
  .t-hero__block :global(.tblock__row) { border-top-color: rgb(240 225 206 / .14); }
  .t-verify { color: var(--red-200); }

  .red { display: grid; gap: clamp(40px, 5vw, 72px); }
  .red__h { font-size: clamp(2.8rem, 6.6vw, 6.6rem); max-width: 15ch; }
  .red__row { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(32px, 5vw, 80px); align-items: end; }
  .red__list { list-style: none; margin: 0; padding: 0; display: grid; }
  .red__list li { padding: 22px 0; border-top: 1px solid rgb(240 225 206 / .35); font-size: 1.125rem; line-height: 1.5; }
  .red__list strong { display: block; font-family: var(--f-display); font-variation-settings: "wdth" 80, "opsz" 32; font-size: 1.6rem; line-height: 1.1; margin-bottom: 6px; }
  .theme-red :global(.slot--ph) { background-color: var(--red-600); border-color: var(--red-400); color: var(--cream-300); }

  .mod-head { display: grid; grid-template-columns: 1.3fr 1fr; gap: 32px; align-items: end; margin-bottom: clamp(40px, 5vw, 64px); }
  .mods { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .mod { padding: 22px 20px; border-radius: 12px; background: var(--navy-600); border: 1px solid var(--navy-500); display: grid; gap: 12px; align-content: start; }
  .mod__code { color: var(--red-300); font-size: var(--t-micro); }
  .mod ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; color: var(--navy-100); font-size: var(--t-small); }
  .mod li { padding-top: 8px; border-top: 1px solid var(--navy-500); }

  .cmp { align-items: start; row-gap: 48px; }
  .cmp__head { grid-column: 1 / 6; display: grid; gap: 28px; position: sticky; top: 120px; }
  .cmp__table { grid-column: 7 / 13; }
  .compare { width: 100%; border-collapse: collapse; }
  .compare th, .compare td { text-align: left; vertical-align: top; padding: 18px 14px 18px 0; border-bottom: 1px solid rgb(26 40 65 / .18); }
  .compare thead th { font-family: var(--f-mono); font-size: var(--t-micro); font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--navy-400); padding-top: 0; }
  .compare thead th:last-child { color: var(--red-500); }
  .compare tbody th { font-weight: 600; width: 26%; }
  .compare td:nth-child(2) { color: var(--navy-400); }
  .compare td:last-child { font-weight: 600; }

  .jr { align-items: start; }
  .jr__head { grid-column: 1 / 6; display: grid; gap: 40px; position: sticky; top: 120px; }
  .jr__steps { grid-column: 7 / 13; list-style: none; margin: 0; padding: 0; }
  .jr__steps li { display: grid; grid-template-columns: 64px 1fr; gap: 16px; padding: 30px 0; border-top: var(--hair); }
  .jr__steps li:last-child { border-bottom: var(--hair); }
  .jr__n { color: var(--red-300); font-size: 1.6rem; line-height: 1; }
  .jr__steps h3 { margin-bottom: 8px; }


  .gl-head { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: end; margin-bottom: 24px; }
  .gl { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px; align-items: start; }
  .gl__i--1 { grid-column: 1 / 6; } .gl__i--2 { grid-column: 6 / 9; } .gl__i--3 { grid-column: 9 / 13; }
  .gl__i--4 { grid-column: 1 / 5; } .gl__i--5 { grid-column: 5 / 13; }

  .int { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(32px, 5vw, 80px); align-items: end; }
  .int h2 { font-size: clamp(2.6rem, 5vw, 5rem); }

  .faq__h { grid-column: 1 / 5; align-self: start; }
  .faq__list { grid-column: 6 / 13; border-top: 1px solid var(--cream-400); }
  details { border-bottom: 1px solid var(--cream-400); }
  summary { list-style: none; display: flex; justify-content: space-between; gap: 24px; align-items: center; min-height: 72px; padding: 16px 0; cursor: pointer; font-weight: 600; font-size: 1.125rem; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--red-500); }
  .faq__ic { position: relative; width: 18px; height: 18px; flex: none; }
  .faq__ic::before, .faq__ic::after { content: ""; position: absolute; left: 0; top: 8px; width: 18px; height: 2px; background: var(--red-500); transition: transform .3s var(--ease); }
  .faq__ic::after { transform: rotate(90deg); }
  details[open] .faq__ic::after { transform: rotate(0); }
  .faq details .body { padding: 0 0 24px; color: var(--navy-500); }

  .enq { align-items: start; }
  .enq__copy { grid-column: 1 / 6; --flow: 28px; }
  .enq__form { grid-column: 7 / 13; }
  .enq__tb .link { min-height: 0; justify-self: end; overflow-wrap: anywhere; }
  .enq__copy :global(.enq__pay) { margin-top: 8px; padding-top: 24px; border-top: var(--hair); }

  @media (max-width: 1099px) {
    .t-hero__grid, .red__row, .mod-head, .gl-head, .int { grid-template-columns: 1fr; }
    .t-hero__block { left: 16px; bottom: 16px; }
    .cmp__head, .jr__head { position: static; }
  }
  @media (max-width: 899px) {
    .gl { grid-template-columns: 1fr 1fr; }
    .gl__i { grid-column: auto !important; }
    .gl__i--5 { grid-column: 1 / -1 !important; }
    .mods { grid-template-columns: 1fr; }
  }
  @media (max-width: 599px) {
    .mods { grid-template-columns: 1fr; }
    .t-hero__block { position: relative; left: 0; bottom: 0; width: 100%; margin-top: -48px; }
    .compare thead th:first-child { display: none; }
    .compare tbody tr, .compare thead tr { display: grid; grid-template-columns: 1fr 1fr; column-gap: 12px; }
    .compare tbody tr { border-bottom: 1px solid rgb(26 40 65 / .18); }
    .compare tbody th { grid-column: 1 / -1; display: block; width: auto; padding-bottom: 0; border-bottom: 0; }
    .compare td { border-bottom: 0; }
    .jr__steps li { grid-template-columns: 48px 1fr; }
  }
</style>
