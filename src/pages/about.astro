---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import ImageSlot from '../components/ImageSlot.astro';
import FlutedGlass from '../components/FlutedGlass.astro';
import Arrow from '../components/Arrow.astro';
import { offices } from '../data/site';

const principles = [
  ['Draw it to be built', 'A drawing is finished when a site team can install from it without calling us.'],
  ['Know the reviewer', 'Every market has its codes and its habits. We design for the person who approves the work.'],
  ['Teach what we practise', 'Our training runs inside the consultancy, so what we teach is what we do on live projects.'],
  ['One standard, three countries', 'The same checklists, templates and reviews in Dubai, India and Saudi Arabia.'],
];
const leaders = ['leader-1', 'leader-2', 'leader-3'];
---
<Base title="About Mechbridge" description="Mechbridge International: MEP engineers with 15+ years in the industry, headquartered in Dubai and India with operations in Saudi Arabia.">
  <section class="ah" data-enter aria-labelledby="ah-h">
    <div class="ah__img" aria-hidden="true">
      <ImageSlot id="about-hero" ratio="16 / 9" alt="" label="Dubai skyline at dusk from a construction site" eager />
    </div>
    <div class="wrap ah__inner">
      <h1 id="ah-h">Engineers first, for fifteen years and counting.</h1>
      <div class="ah__panel glass" data-enter-item>
        <p class="lede">Mechbridge International is a group of MEP and fire engineers with headquarters in Dubai and India and operations in Saudi Arabia. Mechbridge MEP Consultants, our consultancy, also trains the next generation of engineers for the region.</p>
      </div>
    </div>
  </section>

  <section class="section g-cream theme-cream" aria-labelledby="st-h">
    <div class="wrap grid-12 st">
      <div class="st__copy stack">
        <h2 id="st-h" data-split>Built in the Gulf, staffed across two regions.</h2>
        <p class="lede">We started as a small team of MEP engineers working on Gulf projects. The work grew, and so did the problems we kept seeing: drawings that couldn't be built, submissions that bounced, and graduates who knew the theory but had never seen a live set.</p>
        <p class="body">Our answer was a firm where design teams in India and the Gulf work to one standard, engineers handle approvals themselves, and the consultancy trains graduates on the same projects it delivers.</p>
      </div>
      <div class="st__media">
        <ImageSlot id="about-story-1" ratio="4 / 5" alt="Early Mechbridge team photo in a small office" label="Team photo, early office" />
        <ImageSlot id="about-story-2" ratio="1 / 1" alt="Engineers on a rooftop plant deck in Dubai" label="Rooftop plant deck, Dubai" />
      </div>
    </div>
  </section>

  <section class="section g-navy" aria-labelledby="rv-h">
    <div class="wrap rv">
      <div class="stack">
        <h2 id="rv-h" data-split>Changing how the GCC and the subcontinent build.</h2>
        <p class="lede">Projects across the GCC and the subcontinent are often designed in one country and built in another, by teams who never meet. We connect them: Indian engineering depth, Gulf delivery, and one set of codes, templates and reviews between them.</p>
        <p class="body">Training is part of that plan. The region needs engineers who can work on these projects from their first day, and our consultancy is where those projects are.</p>
        <a class="link" href={u('/training')}>How our training works <Arrow /></a>
      </div>
      <FlutedGlass ratio="4 / 5" rib={26} left="GCC" right="Subcontinent" />
    </div>
  </section>

  <section class="section g-deep" aria-labelledby="of-h">
    <div class="wrap">
      <h2 id="of-h" class="of__h" data-split>Where we work.</h2>
      <ul class="of">
        {offices.map((o) => (
          <li>
            <ImageSlot id={`${o.img}-wide`} ratio="16 / 10" alt={`Mechbridge in ${o.city}`} label={`${o.city}: office or city`} />
            <div class="of__meta">
              <h3>{o.city}</h3>
              <p class="mono of__role">{o.role}</p>
              <p class="body">{o.note}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section g-navy" aria-labelledby="pp-h">
    <div class="wrap grid-12 pp">
      <h2 id="pp-h" class="pp__h" data-split>How we work.</h2>
      <ul class="pp__list">
        {principles.map(([t, d]) => <li><h3>{t}</h3><p class="body">{d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section g-paper theme-paper" aria-labelledby="ld-h">
    <div class="wrap">
      <div class="ld-head">
        <h2 id="ld-h" data-split>The people who lead the work.</h2>
        <p class="body">Every discipline at Mechbridge is led by an engineer who still reviews drawings.</p>
      </div>
      <ul class="ld">
        {leaders.map((id) => (
          <li><ImageSlot id={id} ratio="3 / 4" alt="Mechbridge leadership portrait" label="Leadership portrait" /><p class="ld__n">Name to come</p><p class="body">Role to come</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section g-red theme-red" aria-labelledby="ab-c">
    <div class="wrap ab-c">
      <h2 id="ab-c" data-split>Work with us, or learn with us.</h2>
      <div class="btn-row">
        <a class="btn" href={u('/contact')}>Start a project conversation <Arrow /></a>
        <a class="btn btn--ghost" href={u('/training#enquire')}>Enquire about training</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .ah { position: relative; min-height: 92svh; display: flex; align-items: flex-end; background: var(--navy-900); overflow: hidden; }
  .ah__img { position: absolute; inset: 0; }
  .ah__img :global(.slot) { height: 100%; aspect-ratio: auto !important; border-radius: 0; border: 0; }
  .ah__inner { position: relative; display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: end; padding: calc(var(--nav-h) + 80px) 0 clamp(48px, 7vw, 96px); }
  .ah h1 { max-width: 12ch; }
  .ah__panel { padding: 28px; }

  .st { align-items: center; }
  .st__copy { grid-column: 1 / 7; --flow: 24px; }
  .st__media { grid-column: 8 / 13; display: grid; grid-template-columns: 1.2fr 1fr; gap: 16px; align-items: end; }

  .rv { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(40px, 6vw, 112px); align-items: center; }
  .rv .stack { --flow: 28px; }
  .rv h2 { max-width: 14ch; }

  .of__h { margin-bottom: clamp(40px, 5vw, 64px); }
  .of { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .of__meta { display: grid; gap: 6px; margin-top: 20px; }
  .of__role { color: var(--red-300); text-transform: uppercase; letter-spacing: .1em; font-size: var(--t-micro); }

  .pp { align-items: start; }
  .pp__h { grid-column: 1 / 5; }
  .pp__list { grid-column: 6 / 13; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 40px 32px; }
  .pp__list li { border-top: 2px solid var(--red-500); padding-top: 20px; display: grid; gap: 10px; }

  .ld-head { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: end; margin-bottom: clamp(40px, 5vw, 64px); }
  .ld { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .ld__n { margin-top: 16px; font-weight: 600; font-size: 1.125rem; }

  .ab-c { display: grid; gap: 40px; }
  .ab-c h2 { font-size: clamp(2.8rem, 7vw, 7rem); max-width: 14ch; }

  @media (max-width: 1099px) {
    .ah__inner, .rv, .ld-head { grid-template-columns: 1fr; }
    .of, .ld { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 599px) {
    .of, .ld, .pp__list { grid-template-columns: 1fr; }
    .ah__panel { padding: 20px; }
  }
</style>
