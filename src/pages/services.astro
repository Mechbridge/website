---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import ImageSlot from '../components/ImageSlot.astro';
import Arrow from '../components/Arrow.astro';

const services = [
  {
    id: 'mep', ref: 'M / P / E', title: 'MEP design',
    text: 'Concept to construction drawings for HVAC, plumbing and drainage, power, lighting and low-current systems. Every set is coordinated in BIM before it leaves the office.',
    items: ['HVAC, ventilation and smoke control', 'Water supply, drainage and storm', 'Power, lighting and earthing', 'ELV: data, security, PA, BMS', 'Energy and sustainability compliance'],
    img: 'svc-mep', alt: 'Ducts, chilled water pipes and cable trays in a coordinated ceiling', label: 'Coordinated services in a ceiling void',
  },
  {
    id: 'fire', ref: 'FP / FA', title: 'Fire and life safety',
    text: 'Fire fighting, fire alarm and life safety strategies designed to the UAE Fire & Life Safety Code, SBC 801 and NFPA, and followed through Civil Defence approval.',
    items: ['Sprinklers, hydrants and fire pumps', 'Clean-agent and special suppression', 'Fire alarm and voice evacuation', 'Smoke management and pressurisation', 'Egress and life safety strategies'],
    img: 'svc-fire', alt: 'Fire pump set with red pipework in a plant room', label: 'Fire pump room, red pipework',
  },
  {
    id: 'codes', ref: 'A', title: 'Codes and authority approvals',
    text: 'We know how each authority reads a drawing. We prepare the submissions, track them, and answer comments until the approval is issued.',
    items: ['Dubai Municipality and Civil Defence', 'DEWA and SEC utility approvals', 'Saudi Building Code compliance', 'Green building regulations', 'Code compliance reviews of third-party designs'],
    img: 'svc-codes', alt: 'Stamped approval drawings laid out on a desk', label: 'Stamped approval drawings',
  },
  {
    id: 'bim', ref: 'BIM', title: 'BIM and coordination',
    text: 'Revit MEP models from LOD 300 to 400, clash detection in Navisworks, and coordination meetings run by engineers who understand the systems they move.',
    items: ['Revit MEP modelling', 'Clash detection and resolution', 'Shop drawing and builder’s work', 'BIM execution plans', 'As-built models'],
    img: 'svc-bim', alt: 'Navisworks clash detection view on a large monitor', label: 'Clash detection on a large screen',
  },
  {
    id: 'site', ref: 'T&C', title: 'Supervision and commissioning',
    text: 'Our engineers stay with the project on site: inspecting installations, witnessing tests and signing off systems before handover.',
    items: ['Site supervision and inspections', 'Material and shop drawing reviews', 'Testing and commissioning witness', 'Snagging and handover', 'Operation and maintenance reviews'],
    img: 'svc-site', alt: 'Engineer with a clipboard inspecting a chiller on a rooftop', label: 'Rooftop chiller inspection',
  },
  {
    id: 'review', ref: 'PR', title: 'Peer review and value engineering',
    text: 'An independent check of someone else’s MEP design for code compliance, buildability and cost, with a clear list of what to change.',
    items: ['Design and code audits', 'Value engineering options', 'Load and sizing verification', 'Tender document reviews'],
    img: 'svc-review', alt: 'Two engineers comparing a printed drawing with a tablet model', label: 'Two engineers comparing print and model',
  },
];
const sectors = [
  { id: 'sector-residential', name: 'Residential towers and villas' },
  { id: 'sector-hospitality', name: 'Hotels and hospitality' },
  { id: 'sector-retail', name: 'Malls and retail' },
  { id: 'sector-health', name: 'Healthcare' },
  { id: 'sector-industrial', name: 'Industrial and warehousing' },
  { id: 'sector-offices', name: 'Offices and mixed use' },
];
const process = [
  ['Brief and survey', 'We read the architecture, visit the site and agree the design basis.'],
  ['Concept and schematic', 'System options, loads and space planning, priced against each other.'],
  ['Detailed design', 'Coordinated drawings, calculations and specifications.'],
  ['Approvals', 'Authority and utility submissions, tracked to sign-off.'],
  ['Construction', 'Shop drawing reviews, site inspections, testing and commissioning.'],
];
---
<Base title="MEP, fire and life safety services" description="MEP design, fire and life safety, authority approvals, BIM coordination and site supervision from Mechbridge International in the UAE, Saudi Arabia and India.">
  <section class="sh" data-enter aria-labelledby="sh-h">
    <div class="wrap sh__grid">
      <h1 id="sh-h">Every system behind the walls, designed and approved.</h1>
      <div class="sh__side" data-enter-item>
        <p class="lede">Mechbridge designs the mechanical, electrical, plumbing and fire systems of buildings across the UAE, Saudi Arabia and India, then stays with them through approval and commissioning.</p>
        <div class="btn-row">
          <a class="btn" href={u('/contact')}>Discuss a project <Arrow /></a>
          <a class="btn btn--ghost" href="#services">Browse services</a>
        </div>
      </div>
    </div>
    <div class="wrap sh__img" data-enter-item>
      <ImageSlot id="services-hero" ratio="21 / 8" alt="Plant room with chillers, pumps and red fire mains" label="Plant room: chillers, pumps, red fire mains" eager />
    </div>
  </section>

  <section class="g-navy" id="services" aria-label="Services">
    {services.map((s, n) => (
      <article class:list={['svc', 'section', { 'svc--flip': n % 2 === 1, 'g-cream theme-cream': n === 1 || n === 4 }]} id={s.id} aria-labelledby={`svc-${s.id}`}>
        <div class="wrap svc__grid">
          <div class="svc__media">
            <ImageSlot id={s.img} ratio="4 / 5" alt={s.alt} label={s.label} />
          </div>
          <div class="svc__copy stack">
            <h2 id={`svc-${s.id}`} data-split>{s.title}</h2>
            <p class="lede">{s.text}</p>
            <ul class="svc__items">{s.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="section g-deep" aria-labelledby="sec-h">
    <div class="wrap">
      <h2 id="sec-h" class="sec__h" data-split>Buildings we engineer.</h2>
      <ul class="sec">
        {sectors.map((s) => (
          <li><ImageSlot id={s.id} ratio="1 / 1" alt={s.name} label={s.name} /><p>{s.name}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section g-navy" aria-labelledby="pr-h">
    <div class="wrap">
      <h2 id="pr-h" class="pr__h" data-split>How a project moves through our office.</h2>
      <ol class="pr">
        {process.map(([t, d], i) => (
          <li><span class="dot pr__n">{String(i + 1).padStart(2, '0')}</span><h3>{t}</h3><p class="body">{d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section g-red theme-red" aria-labelledby="xt-h">
    <div class="wrap xt">
      <div class="stack">
        <h2 id="xt-h" data-split>The same engineers teach.</h2>
        <p class="lede">Everything on this page is also a training track at Mechbridge MEP Consultants, taught by the people who do it for our clients.</p>
        <a class="btn" href={u('/training')}>See training tracks <Arrow /></a>
      </div>
      <ImageSlot id="services-teach" ratio="3 / 2" alt="Mechbridge engineer explaining a ductwork detail to trainees" label="Engineer explaining a detail to trainees" />
    </div>
  </section>
</Base>

<style>
  .sh { background: var(--navy-800); padding: calc(var(--nav-h) + clamp(40px, 6vw, 96px)) 0 clamp(56px, 7vw, 104px); }
  .sh__grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(32px, 5vw, 80px); align-items: end; }
  .sh h1 { max-width: 13ch; }
  .sh__side { display: grid; gap: 28px; }
  .sh__img { margin-top: clamp(48px, 6vw, 88px); }

  .svc__grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(40px, 6vw, 112px); align-items: center; }
  .svc--flip .svc__media { order: 2; }
  .svc__copy { --flow: 24px; }
  .svc__ref { color: var(--red-300); letter-spacing: .1em; }
  .theme-cream .svc__ref { color: var(--red-500); }
  .svc__items { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; }
  .svc__items li { padding: 14px 0; border-top: var(--hair); }

  .sec__h { margin-bottom: clamp(40px, 5vw, 64px); }
  .sec { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 16px; }
  .sec p { margin-top: 14px; font-weight: 600; }

  .pr__h { max-width: 16ch; margin-bottom: clamp(40px, 5vw, 72px); }
  .pr { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0; border-top: 2px solid var(--red-500); }
  .pr li { padding: 28px 24px 0 0; display: grid; gap: 10px; align-content: start; }
  .pr__n { color: var(--red-300); font-size: 1.4rem; }

  .xt { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: center; }
  .xt h2 { font-size: clamp(2.8rem, 6vw, 6rem); }
  .theme-red :global(.slot--ph) { background-color: var(--red-600); border-color: var(--red-400); color: var(--cream-300);
    background-image: linear-gradient(rgb(240 225 206 / .1) 1px, transparent 1px), linear-gradient(90deg, rgb(240 225 206 / .1) 1px, transparent 1px); background-size: 40px 40px; }

  @media (max-width: 1099px) {
    .sec { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .pr { grid-template-columns: 1fr 1fr; row-gap: 32px; }
  }
  @media (max-width: 899px) {
    .sh__grid, .svc__grid, .xt { grid-template-columns: 1fr; }
    .svc--flip .svc__media { order: 0; }
    .svc__media :global(.slot) { --ar: 4 / 3 !important; }
  }
  @media (max-width: 599px) {
    .svc__items { grid-template-columns: 1fr; }
    .sec { grid-template-columns: 1fr 1fr; }
    .pr { grid-template-columns: 1fr; }
    .sh__img :global(.slot) { --ar: 4 / 3 !important; }
  }
</style>
