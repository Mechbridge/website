---
// Printable certificate (A4 landscape). Staff only: data comes from the admin API.
import Admin from '../../layouts/Admin.astro';
import Logo from '../../components/Logo.astro';
import { site } from '../../data/site';
import { u } from '../../lib/url';
---
<Admin title="Certificate">
  <div class="cert-tools">
    <a class="btn btn--quiet btn--sm" href={u('/admin/#/certificates')}>Back to certificates</a>
    <button class="btn btn--sm" type="button" onclick="window.print()">Print or save as PDF</button>
    <p class="adm-hint">Use A4 landscape, margins "None", background graphics on.</p>
  </div>
  <p class="adm-empty" data-state>Loading certificate…</p>
  <article class="cert" data-cert hidden aria-label="Certificate">
    <div class="cert__frame">
      <header class="cert__top">
        <div class="cert__logo"><Logo /></div>
        <div class="cert__co">
          <p class="cert__company">{site.company}</p>
          <p class="cert__web mono">{site.domain}</p>
        </div>
      </header>
      <div class="cert__main">
        <p class="cert__kind" data-f="kind">Certificate of Completion</p>
        <p class="cert__lead">This certifies that</p>
        <p class="cert__name" data-f="holder_name"></p>
        <p class="cert__lead" data-f="verb">has successfully completed</p>
        <p class="cert__title" data-f="title"></p>
        <p class="cert__remarks" data-f="remarks" hidden></p>
        <p class="cert__batch" data-f="batch"></p>
        <p class="cert__batch" data-f="period" hidden></p>
        <p class="cert__batch" data-f="grade" hidden></p>
        <p class="cert__modules" data-f="modules" hidden></p>
      </div>
      <footer class="cert__foot">
        <div class="cert__meta">
          <p><span>Issued on</span><b data-f="issue_date"></b></p>
          <p><span>Certificate code</span><b class="mono" data-f="code"></b></p>
          <p class="cert__revoked" data-f="revoked" hidden>REVOKED</p>
        </div>
        <div class="cert__sign">
          <span class="cert__line"></span>
          <p class="cert__signame" data-f="signame" hidden></p>
          <p data-f="signtitle">Authorised signatory</p>
          <p class="cert__small">{site.company}</p>
        </div>
        <div class="cert__qr">
          <span class="cert__qrbox" data-f="qr"></span>
          <p class="cert__small">Scan to verify, or visit <span data-f="verify"></span></p>
        </div>
      </footer>
    </div>
  </article>
</Admin>

<script>
  import QRCode from 'qrcode';
  import { api } from '../../lib/api/client';
  import { u } from '../../lib/url';

  const state = document.querySelector<HTMLElement>('[data-state]')!;
  const cert = document.querySelector<HTMLElement>('[data-cert]')!;
  const f = (k: string) => cert.querySelector<HTMLElement>(`[data-f="${k}"]`)!;
  const id = Number(new URLSearchParams(location.search).get('id'));

  (async () => {
    try {
      if (!(await api.me())) { state.textContent = 'Log in to the staff portal first.'; return; }
      const c = await api.certificate(id);
      const internship = c.programme === 'internship';
      f('kind').textContent = internship ? 'Certificate of Internship' : 'Certificate of Completion';
      f('verb').textContent = internship ? 'has successfully completed the' : 'has successfully completed';
      f('holder_name').textContent = c.holder_name;
      f('title').textContent = c.title;
      const show = (k: string, text: string) => { f(k).textContent = text; f(k).hidden = !text; };
      const long = (d: string) => (d ? new Date(d + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : '');
      show('batch', [c.batch, c.mode, c.hours].filter(Boolean).join(' · '));
      show('remarks', c.remarks);
      show('period', c.period_from && c.period_to ? `From ${long(c.period_from)} to ${long(c.period_to)}` : c.period_from ? `From ${long(c.period_from)}` : c.period_to ? `Completed ${long(c.period_to)}` : '');
      show('modules', c.modules ? `Modules: ${c.modules.split('\n').filter(Boolean).join(' · ')}` : '');
      show('grade', c.grade ? `Result: ${c.grade}` : '');
      // More lines on the page: tighten the type so everything stays inside the border.
      cert.classList.toggle('cert--dense', [c.remarks, c.period_from || c.period_to, c.modules, c.grade, c.mode || c.hours].filter(Boolean).length >= 2);
      show('signame', c.signatory_name);
      f('signtitle').textContent = c.signatory_title || 'Authorised signatory';
      f('issue_date').textContent = new Date(c.issue_date + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
      f('code').textContent = c.code;
      f('revoked').hidden = c.status !== 'revoked';
      const verifyUrl = `${location.origin}${u('/verify')}?code=${c.code}`;
      f('verify').textContent = `${location.host}${u('/verify')}`;
      const img = new Image(112, 112);
      img.alt = 'QR code linking to the online verification of this certificate';
      img.src = await QRCode.toDataURL(verifyUrl, { margin: 0, width: 300, color: { dark: '#1A2841', light: '#FBF8F3' } });
      f('qr').replaceChildren(img);
      document.title = `${c.code} · ${c.holder_name}`;
      state.hidden = true; cert.hidden = false;
    } catch (e) {
      state.textContent = (e as Error).message || 'This certificate could not load.';
    }
  })();
</script>

<style>
  .cert-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; padding: 18px 24px; }
  .cert { width: min(1123px, calc(100vw - 32px)); aspect-ratio: 297 / 210; margin: 0 auto 40px; background: var(--paper-white); color: var(--navy-700); padding: 2.2%; box-shadow: 0 30px 80px -30px rgb(0 0 0 / .7); }
  .cert__frame { height: 100%; border: 2px solid var(--navy-700); outline: 1px solid var(--red-500); outline-offset: -10px; padding: 4% 6%; display: grid; grid-template-rows: auto 1fr auto; }
  .cert__top { display: flex; justify-content: space-between; align-items: center; gap: 24px; }
  .cert__logo { color: var(--navy-700); }
  .cert__logo :global(svg) { height: clamp(56px, 9vw, 96px); width: auto; }
  .cert__co { text-align: right; }
  .cert__company { font-family: var(--f-display); font-variation-settings: "wdth" 80; font-weight: 700; font-size: clamp(.9rem, 1.6vw, 1.25rem); }
  .cert__web { color: var(--red-500); font-size: clamp(.65rem, 1vw, .8rem); }
  .cert__main { display: grid; align-content: center; justify-items: center; text-align: center; gap: .6em; }
  .cert__kind { font-family: var(--f-display); font-variation-settings: "wdth" 75, "opsz" 96; font-weight: 780; text-transform: uppercase; letter-spacing: .04em; font-size: clamp(1.4rem, 3.4vw, 2.8rem); color: var(--red-500); }
  .cert__lead { font-size: clamp(.8rem, 1.3vw, 1.05rem); color: var(--navy-400); }
  .cert__name { font-family: var(--f-display); font-variation-settings: "wdth" 85, "opsz" 96; font-weight: 700; font-size: clamp(1.8rem, 4.6vw, 3.8rem); line-height: 1.05; padding: 0 1em .1em; border-bottom: 1px solid var(--cream-500); }
  .cert__title { font-family: var(--f-display); font-variation-settings: "wdth" 85, "opsz" 48; font-weight: 700; font-size: clamp(1rem, 2.2vw, 1.8rem); }
  .cert__batch { font-size: clamp(.75rem, 1.1vw, .9rem); color: var(--navy-400); }
  .cert__remarks { font-size: clamp(.8rem, 1.2vw, 1rem); color: var(--navy-600); max-width: 70ch; }
  .cert__modules { font-size: clamp(.62rem, .95vw, .8rem); color: var(--navy-400); max-width: 80ch; line-height: 1.5; }
  .cert__signame { font-weight: 700; color: var(--navy-700); }
  .cert--dense .cert__frame { padding: 3% 5.5%; }
  .cert--dense .cert__main { gap: .32em; }
  .cert--dense .cert__kind { font-size: clamp(1.15rem, 2.7vw, 2.25rem); }
  .cert--dense .cert__name { font-size: clamp(1.5rem, 3.7vw, 3.1rem); }
  .cert--dense .cert__title { font-size: clamp(.95rem, 1.9vw, 1.55rem); }
  .cert--dense .cert__logo :global(svg) { height: clamp(46px, 7vw, 80px); }
  .cert--dense .cert__qrbox :global(img) { width: clamp(64px, 8.5vw, 100px); }
  .cert__foot { display: grid; grid-template-columns: 1fr 1fr auto; gap: 24px; align-items: end; }
  .cert__meta { display: grid; gap: 6px; font-size: clamp(.7rem, 1.1vw, .9rem); }
  .cert__meta span { display: block; color: var(--navy-400); font-size: .8em; text-transform: uppercase; letter-spacing: .08em; }
  .cert__revoked { color: var(--red-500); font-weight: 800; letter-spacing: .2em; border: 2px solid var(--red-500); padding: 2px 8px; justify-self: start; }
  .cert__sign { text-align: center; font-size: clamp(.7rem, 1.1vw, .9rem); }
  .cert__line { display: block; height: 1px; background: var(--navy-700); margin-bottom: 8px; }
  .cert__small { font-size: clamp(.6rem, .9vw, .75rem); color: var(--navy-400); }
  .cert__qr { display: grid; justify-items: center; gap: 6px; max-width: 160px; text-align: center; }
  .cert__qrbox :global(img) { width: clamp(72px, 10vw, 112px); height: auto; }
  @page { size: A4 landscape; margin: 0; }
  @media print {
    :global(.adm-body) { background: #fff; }
    .cert-tools, [data-state] { display: none !important; }
    .cert { width: 297mm; height: 210mm; aspect-ratio: auto; margin: 0; box-shadow: none; padding: 8mm; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>
