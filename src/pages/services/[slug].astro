---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import Arrow from '../../components/Arrow.astro';
import { services, type Service } from '../../data/services';
import { serves } from '../../data/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}
const { service: s } = Astro.props as { service: Service };
const i = services.findIndex((x) => x.slug === s.slug);
const related = [services[(i + 1) % services.length], services[(i + 2) % services.length]];
const total = s.groups.reduce((n, g) => n + g.items.length, 0);
const serviceLd = [{
  '@type': 'Service',
  name: s.title,
  serviceType: s.title,
  description: s.lede,
  url: `https://mechbridgegroup.com/services/${s.slug}`,
  image: `https://mechbridgegroup.com/og/${s.slug}.jpg`,
  provider: { '@id': 'https://mechbridgegroup.com/#organization' },
  areaServed: serves.map((name) => ({ '@type': 'Country', name })),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `${s.title} scope`,
    itemListElement: s.groups.map((g) => ({
      '@type': 'OfferCatalog',
      name: g.title,
      itemListElement: g.items.map((it) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: it } })),
    })),
  },
}];
---
<Base og={s.slug} ogAlt={`${s.title}: ${s.highlights.join(', ')}`} breadcrumbs={[['Services', '/services'], [s.title, `/services/${s.slug}`]]} jsonLd={serviceLd} title={s.title} description={`${s.title} from Mechbridge International MEP Consultants: ${s.highlights.join(', ')}. Projects across the GCC and India.`}>
  <section class="sh" data-enter aria-labelledby="sh-h">
    <div class="wrap">
      <nav class="crumbs mono" aria-label="Breadcrumb" data-enter-item>
        <a href={u('/services')}>Services</a><span aria-hidden="true">/</span><span aria-current="page">{s.title}</span>
      </nav>
      <div class="sh__grid">
        <div class="sh__copy">
          <h1 id="sh-h">{s.title}</h1>
          <p class="lede" data-enter-item>{s.lede}</p>
          <div class="btn-row" data-enter-item>
            <a class="btn" href="#proposal">Request a proposal <Arrow /></a>
            <a class="btn btn--ghost" href="#scope">See the full scope</a>
          </div>
        </div>
        <div class="tblock sh__tb" data-enter-item>
          <div class="tblock__row"><span class="tblock__k">Discipline</span><span class="tblock__v mono">{s.ref}</span></div>
          {s.highlights.map((h) => <div class="tblock__row"><span class="tblock__k">Core</span><span class="tblock__v">{h}</span></div>)}
          <div class="tblock__row"><span class="tblock__k">Scope items</span><span class="tblock__v">{total}</span></div>
        </div>
      </div>
    </div>
    <div class="wrap sh__img">
      <ImageSlot id={`${s.img}-wide`} ratio="21 / 9" alt={`${s.title} work: plant, drawings and installed services`} label={`${s.title}: wide project shot`} eager />
    </div>
  </section>

  <section class="section g-cream theme-cream" id="scope" aria-labelledby="scope-h">
    <div class="wrap">
      <div class="scope-head">
        <h2 id="scope-h" data-split>What we deliver.</h2>
        <ImageSlot id={`${s.img}-detail`} ratio="4 / 3" alt={`Close-up of ${s.title.toLowerCase()} drawings and details`} label={`${s.title}: drawing close-up`} />
      </div>
      <div class="scope" style={`--cols:${Math.min(s.groups.length, 4)}`}>
        {s.groups.map((g) => (
          <div class="scope__g">
            <h3>{g.title}</h3>
            <ul>{g.items.map((it) => <li>{it}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section g-deep" aria-labelledby="out-h">
    <div class="wrap out">
      <div>
        <h2 id="out-h" class="out__h" data-split>What you receive.</h2>
        <ul class="out__list">{s.deliverables.map((d) => <li>{d}</li>)}</ul>
      </div>
      <div class="out__side">
        <h3 class="out__k">{s.slug === 'mep-design' ? 'Tools and standards' : s.slug.startsWith('mep-estimation') ? 'Measurement standards' : 'Codes we design to'}</h3>
        <ul class="chips">{s.codes.map((c) => <li>{c}</li>)}</ul>
        <div class="rel">
          <h3 class="out__k">Often combined with</h3>
          {related.map((r) => <a class="link" href={u(`/services/${r.slug}`)}>{r.title} <Arrow /></a>)}
          <a class="link" href={u('/training')}>Professional Engineering Training <Arrow /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section g-navy" id="proposal" aria-labelledby="p-h">
    <div class="wrap grid-12 enq">
      <div class="enq__copy stack">
        <h2 id="p-h" data-split>Request a proposal.</h2>
        <p class="lede">Send the project type, location, stage and the drawings you have. An engineer replies with scope, programme and fee.</p>
      </div>
      <div class="enq__form"><EnquiryForm id="proposal-form" type="consultancy" types={['consultancy']} serviceSelect service={s.title} submit="Send request" /></div>
    </div>
  </section>
</Base>

<style>
  .sh { background: var(--navy-800); padding: calc(var(--nav-h) + clamp(32px, 4vw, 64px)) 0 clamp(56px, 7vw, 104px); }
  .crumbs { display: flex; gap: 10px; align-items: center; color: var(--navy-200); margin-bottom: 28px; flex-wrap: wrap; }
  .crumbs a { color: var(--cream-300); text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  .crumbs a:hover { color: var(--red-300); }
  .sh__grid { display: grid; grid-template-columns: 1.4fr .8fr; gap: clamp(32px, 5vw, 80px); align-items: end; }
  .sh__copy { display: grid; gap: 28px; }
  .sh h1 { font-size: clamp(3rem, 7.4vw, 7.4rem); max-width: 12ch; }
  .sh__img { margin-top: clamp(48px, 6vw, 88px); }

  .scope-head { display: grid; grid-template-columns: 1fr minmax(0, 420px); gap: 40px; align-items: end; margin-bottom: clamp(40px, 5vw, 64px); }
  .scope { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 32px; }
  .scope__g { border-top: 2px solid var(--red-500); padding-top: 18px; }
  .scope__g h3 { margin-bottom: 14px; }
  .scope__g ul { list-style: none; margin: 0; padding: 0; }
  .scope__g li { padding: 11px 0; border-bottom: 1px solid rgb(26 40 65 / .16); }

  .out { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
  .out__h { margin-bottom: 32px; }
  .out__list { list-style: none; margin: 0; padding: 0; }
  .out__list li { font-family: var(--f-display); font-variation-settings: "wdth" 80, "opsz" 48; font-weight: 700; font-size: clamp(1.5rem, 2.4vw, 2.2rem); line-height: 1.1; padding: 18px 0; border-top: var(--hair); }
  .out__side { display: grid; gap: 20px; padding-top: 12px; }
  .out__k { font-family: var(--f-mono); font-size: var(--t-micro); font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--navy-200); font-variation-settings: normal; }
  .rel { display: grid; gap: 2px; margin-top: 20px; }
  .rel .out__k { margin-bottom: 8px; }

  .enq { align-items: start; }
  .enq__copy { grid-column: 1 / 6; --flow: 28px; }
  .enq__form { grid-column: 7 / 13; }

  @media (max-width: 1099px) {
    .sh__grid, .out { grid-template-columns: 1fr; }
    .scope { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    .scope-head, .scope { grid-template-columns: 1fr; }
    .sh__img :global(.slot) { --ar: 4 / 3 !important; }
  }
</style>
