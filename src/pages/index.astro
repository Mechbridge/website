---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import ImageSlot from '../components/ImageSlot.astro';
import FlutedGlass from '../components/FlutedGlass.astro';
import Arrow from '../components/Arrow.astro';
import { tracks } from '../data/tracks';
import { site, offices } from '../data/site';
import { compare, steps } from '../data/training';

const disciplines = [
  { ref: 'M', name: 'HVAC and ventilation', note: 'Cooling for 46°C summers, fresh air, smoke control' },
  { ref: 'P', name: 'Plumbing and drainage', note: 'Water supply, drainage, storm, plant rooms' },
  { ref: 'E', name: 'Power and lighting', note: 'Load schedules, single lines, utility submissions' },
  { ref: 'ELV', name: 'Low-current systems', note: 'Data, security, PA, BMS integration' },
  { ref: 'BIM', name: 'BIM coordination', note: 'Revit models, clash detection, issue-ready sheets' },
];
const codes = ['UAE Fire & Life Safety Code', 'Saudi Building Code', 'NFPA 13 / 14 / 20 / 72', 'ASHRAE 62.1 / 90.1', 'DEWA regulations', 'SEC distribution code', 'Dubai Municipality', 'Dubai Civil Defence', 'Al Sa’fat', 'Estidama'];
// Clay piece positions for this page (fractions of width / of each section). Content sits on the other side.
const clayDesktop = [
  { x: 0.87, y: 0.3 }, { x: 0.12, y: 0.62 }, { x: 0.86, y: 0.58 }, { x: 0.12, y: 0.3 }, { x: 0.87, y: 0.78 },
  { x: 0.88, y: 0.26 }, { x: 0.09, y: 0.16 }, { x: 0.88, y: 0.26 }, { x: 0.87, y: 0.74 }, { x: 0.13, y: 0.52 },
];
const clayMobile = Array.from({ length: 10 }, (_, i) => ({ x: i % 2 ? 0.26 : 0.74, ypx: 128 }));
---
<Base
  title={site.name}
  description="Mechbridge International designs MEP, fire and life safety systems from Dubai, India and Saudi Arabia, and trains engineers on live Gulf projects."
  glassNav
>
  <Fragment slot="outside">
    <div class="clay-ground" id="clay-ground" aria-hidden="true"></div>
    <canvas class="clay-stage" id="clay-stage" aria-hidden="true"></canvas>
  </Fragment>

  <!-- ================= HERO ================= -->
  <section class="hero" data-enter aria-labelledby="hero-h">
    <div class="hero__media" data-hero-photo>
      <img src={u('/images/hero-home.webp')} alt="" width="1672" height="941" fetchpriority="high" />
    </div>
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="wrap hero__inner">
      <div class="hero__copy">
        <h1 id="hero-h">Engineering the buildings of the Gulf and India.</h1>
        <p class="lede" data-enter-item>MEP, fire and life safety design from Dubai, India and Saudi Arabia. And training for the engineers who will build what comes next, taught on our live projects.</p>
        <div class="btn-row" data-enter-item>
          <a class="btn" href={u('/training')}>Explore training <Arrow /></a>
          <a class="btn btn--ghost" href={u('/services')}>See our services</a>
        </div>
      </div>
      <aside class="hero__block glass" data-enter-item aria-label="Mechbridge at a glance">
        <div class="tblock__row"><span class="tblock__k">Headquarters</span><span class="tblock__v">Dubai · India</span></div>
        <div class="tblock__row"><span class="tblock__k">Operations</span><span class="tblock__v">Saudi Arabia</span></div>
        <div class="tblock__row"><span class="tblock__k">In the industry</span><span class="tblock__v">15+ years</span></div>
        <div class="tblock__row"><span class="tblock__k">Training</span><a class="tblock__v hero__live dot live" href={u('/training#enquire')}>Enrolling</a></div>
      </aside>
    </div>
    <a class="hero__cue dot" href="#who" aria-label="Scroll to the next section">Scroll <Arrow dir="down" /></a>
  </section>

  <!-- ================= CLAY ZONE: 10 equal sections ================= -->
  <div class="clay" id="clay" data-clay data-layout={JSON.stringify(clayDesktop)} data-layout-mobile={JSON.stringify(clayMobile)}>

    <!-- 0 · house · navy -->
    <section class="cs cs--L" id="who" aria-labelledby="s0-h">
      <div class="wrap cs__in">
        <div class="cs__card s0">
          <h2 id="s0-h" data-split>Every system a building runs on, designed by one group.</h2>
          <p class="lede">Mechbridge began as a team of MEP engineers. Fifteen years on, our offices in Dubai, India and Saudi Arabia take buildings from concept to authority approval to handover: the air, water, power and fire systems that make them work.</p>
          <div class="s0__row">
            <ImageSlot id="home-studio" ratio="4 / 3" alt="Mechbridge engineers around a drawing table in the Dubai office" label="Engineers reviewing drawings, Dubai office" />
            <div class="tblock s0__tb">
              <div class="tblock__row"><span class="tblock__k">Design</span><span class="tblock__v">MEP · BIM</span></div>
              <div class="tblock__row"><span class="tblock__k">Safety</span><span class="tblock__v">Fire &amp; life safety</span></div>
              <div class="tblock__row"><span class="tblock__k">Approvals</span><span class="tblock__v">UAE · KSA · India</span></div>
              <div class="tblock__row"><span class="tblock__k">Training</span><span class="tblock__v">6 tracks</span></div>
            </div>
          </div>
          <a class="link" href={u('/about')}>How Mechbridge works <Arrow /></a>
        </div>
      </div>
    </section>

    <!-- 1 · design · navy -->
    <section class="cs cs--R" aria-labelledby="s1-h">
      <div class="wrap cs__in">
        <div class="cs__card s1">
          <h2 id="s1-h" data-split>MEP design, drawn to be built.</h2>
          <div class="s1__row">
            <div class="stack">
              <p class="body">Our drawings are made for the people who build from them: coordinated in BIM, clash-checked, and detailed to the level a site team needs on a Tuesday morning.</p>
              <ul class="register">
                {disciplines.map((d) => (
                  <li><span class="register__ref mono">{d.ref}</span><span class="register__name">{d.name}</span><span class="register__note">{d.note}</span></li>
                ))}
              </ul>
              <a class="link" href={u('/services')}>All design services <Arrow /></a>
            </div>
            <ImageSlot id="home-design" ratio="4 / 5" alt="Coordinated MEP model of a ceiling void with ducts, pipes and cable trays" label="Coordinated MEP model, ceiling void" />
          </div>
        </div>
      </div>
    </section>

    <!-- 2 · foundation · cream -->
    <section class="cs cs--L theme-cream" aria-labelledby="s2-h">
      <div class="wrap cs__in">
        <div class="cs__card s2">
          <h2 id="s2-h" data-split>Built on code from the first sketch.</h2>
          <p class="lede">We design to the codes each authority enforces and prepare the submissions ourselves, so a drawing is written for its reviewer before it's sent.</p>
          <ul class="chips" aria-label="Codes and authorities we work to">
            {codes.map((c) => <li>{c}</li>)}
          </ul>
          <ImageSlot id="home-codes" ratio="16 / 7" alt="Marked-up fire and life safety drawing with red review notes" label="Authority-marked drawing set, red notes" />
        </div>
      </div>
    </section>

    <!-- 3 · construction · deep navy -->
    <section class="cs cs--R" aria-labelledby="s3-h">
      <div class="wrap cs__in">
        <div class="cs__card s3">
          <h2 id="s3-h" data-split>Offices in Dubai, India and Saudi Arabia.</h2>
          <p class="lede">Gulf projects are often designed in one country and built in another, by teams that never meet. Ours share one standard: design teams in India, delivery in the Gulf, and the same drawings, codes and people across all three offices.</p>
          <ul class="offices">
            {offices.map((o) => (
              <li>
                <ImageSlot id={o.img} ratio="3 / 4" alt={`Mechbridge ${o.city}`} label={`${o.city}: city or office`} />
                <p class="offices__role mono">{o.role}</p>
                <p class="offices__city">{o.city}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 4 · plumbing · navy-900 · TRAINING OPENER -->
    <section class="cs cs--L cs--train" id="training" aria-labelledby="s4-h">
      <div class="wrap cs__in">
        <div class="cs__card s4">
          <div class="s4__copy">
            <h2 id="s4-h" class="s4__h" data-split>Learn MEP from the engineers who design it.</h2>
            <p class="lede">Mechbridge MEP Consultants trains engineers for the work we hire for. Your instructors spend their week on live projects in Dubai and Saudi Arabia, and they teach from those drawings.</p>
            <div class="btn-row">
              <a class="btn" href={u('/training#enquire')}>Enquire about the next cohort <Arrow /></a>
              <a class="btn btn--ghost" href={u('/training')}>See how training works</a>
            </div>
          </div>
          <FlutedGlass class="s4__art" ratio="4 / 5" left="MEP Consultants" right="Training" />
        </div>
      </div>
    </section>

    <!-- 5 · airflow · light cream · USP -->
    <section class="cs cs--L theme-cream" aria-labelledby="s5-h">
      <div class="wrap cs__in">
        <div class="cs__card s5">
          <h2 id="s5-h" data-split>Not a classroom. A project office.</h2>
          <div class="s5__row">
            <ImageSlot id="training-markup" ratio="4 / 5" alt="Senior engineer marking up a trainee's HVAC layout in red pen" label="Senior engineer marking up a trainee's layout" />
            <table class="compare">
              <caption class="sr-only">How Mechbridge training compares with a typical course</caption>
              <thead><tr><th scope="col"><span class="sr-only">Topic</span></th><th scope="col">Typical course</th><th scope="col">Mechbridge</th></tr></thead>
              <tbody>
                {compare.map(([k, a, b]) => <tr><th scope="row">{k}</th><td>{a}</td><td>{b}</td></tr>)}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- 6 · electrical · near-black · TRACKS -->
    <section class="cs cs--R" aria-labelledby="s6-h">
      <div class="wrap cs__in">
        <div class="cs__card s6">
          <h2 id="s6-h" class="s6__h" data-split>Pick the building system you want to specialise in.</h2>
          <ul class="tracks">
            {tracks.map((t) => (
              <li>
                <a class="track" href={u(`/training/${t.slug}`)}>
                  <ImageSlot id={t.img} ratio="2 / 1" alt={`${t.title} training`} label={t.title} />
                  <span class="track__ref mono">{t.code}</span>
                  <span class="track__title">{t.title}</span>
                  <span class="track__short">{t.short}</span>
                  <span class="track__go" aria-hidden="true"><Arrow dir="up-right" /></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 7 · solar · navy · HOW IT RUNS -->
    <section class="cs cs--L" aria-labelledby="s7-h">
      <div class="wrap cs__in">
        <div class="cs__card s7">
          <h2 id="s7-h" data-split>How a cohort runs.</h2>
          <div class="s7__row">
            <ol class="steps">
              {steps.map(([t, d], i) => (
                <li><span class="steps__n dot">{String(i + 1).padStart(2, '0')}</span><span class="steps__t">{t}</span><span class="steps__d">{d}</span></li>
              ))}
            </ol>
            <ImageSlot id="training-cohort" ratio="4 / 5" alt="Trainees working on drawings at a shared table with an instructor" label="Cohort at work with an instructor" />
          </div>
        </div>
      </div>
    </section>

    <!-- 8 · inspection · cream · FIRE -->
    <section class="cs cs--L theme-cream" aria-labelledby="s8-h">
      <div class="wrap cs__in">
        <div class="cs__card s8">
          <div class="s8__copy stack">
            <h2 id="s8-h" data-split>Fire and life safety, from first layout to final inspection.</h2>
            <p class="lede">A building can't open until Civil Defence signs it off. We design the systems that get it there and stay through testing and commissioning.</p>
            <ul class="ticks">
              <li>Sprinklers, hydrants, fire pumps and clean-agent suppression</li>
              <li>Fire alarm, voice evacuation and cause-and-effect matrices</li>
              <li>Smoke management and stair pressurisation</li>
              <li>Life safety and means of egress strategies</li>
              <li>Inspection, testing and commissioning support</li>
            </ul>
            <a class="link" href={u('/services#fire')}>Fire and life safety services <Arrow /></a>
          </div>
          <ImageSlot id="home-fire" ratio="4 / 3" alt="Red sprinkler mains and valve set in a plant room" label="Sprinkler valve set, plant room" />
        </div>
      </div>
    </section>

    <!-- 9 · happy · navy · CLOSE -->
    <section class="cs cs--R" aria-labelledby="s9-h">
      <div class="wrap cs__in">
        <div class="cs__card s9">
          <h2 id="s9-h" data-split>Bring us a project, or come and train with us.</h2>
          <div class="s9__row">
            <a class="close glass" href={u('/training#enquire')}>
              <span class="close__t">Train with us</span>
              <span class="close__d">Six tracks taught by engineers on live Gulf projects. Cohorts in Dubai, Saudi Arabia and online.</span>
              <span class="btn">Enquire about training <Arrow /></span>
            </a>
            <a class="close glass" href={u('/contact')}>
              <span class="close__t">Build with us</span>
              <span class="close__d">MEP, fire and life safety design and approvals for projects in the UAE, KSA and India.</span>
              <span class="btn btn--ghost">Start a project conversation <Arrow /></span>
            </a>
          </div>
          <p class="body s9__mail">Write to <a class="link" href={`mailto:${site.connect}`}>{site.connect}</a> · Existing clients: <a class="link" href={`mailto:${site.support}`}>{site.support}</a></p>
        </div>
      </div>
    </section>
  </div>
</Base>

<script src={u('/bg/three.min.js')} is:inline defer></script>
<script src={u('/bg/mb-clay-background.js')} is:inline defer></script>
<script>
  import { initClay } from '../scripts/home-bg';
  initClay();
</script>

<style>
  /* ---------- clay layers (outside the smooth wrapper) ---------- */
  .clay-ground { position: fixed; inset: 0; z-index: 0; background: var(--ground, #1A2841); }
  .clay-stage { position: fixed; left: 0; top: 0; width: 100%; height: 100vh; z-index: 1; display: block; pointer-events: none; }
  :global(#smooth-wrapper) { position: relative; z-index: 2; }

  /* ---------- hero ---------- */
  .hero { position: relative; min-height: 100svh; background: #06080c; overflow: hidden; display: flex; align-items: flex-end; color: var(--cream-300); }
  .hero__media { position: absolute; inset: 0; }
  .hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: 62% 55%; }
  .hero__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(6 8 12 / .55) 0%, rgb(6 8 12 / 0) 26%, rgb(6 8 12 / 0) 52%, rgb(6 8 12 / .82) 100%); }
  .hero__inner { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 48px; align-items: end; padding-block: calc(var(--nav-h) + 48px) clamp(56px, 8vh, 96px); }
  .hero__copy { display: grid; gap: 28px; max-width: 980px; }
  .hero h1 { color: var(--cream-300); font-size: clamp(3.1rem, 7.6vw, 7.6rem); max-width: 13ch; }
  .hero .lede { color: var(--cream-200); max-width: 50ch; }
  .hero__block { padding: 4px 0; }
  .hero__block :global(.tblock__row) { border-top-color: rgb(240 225 206 / .14); }
  .hero__block :global(.tblock__k) { color: var(--navy-100); }
  .hero__live { color: var(--red-200); text-decoration: none; text-transform: uppercase; font-size: .875rem; justify-self: end; }
  .hero__live:hover { color: var(--cream-300); }
  .hero__cue { position: absolute; right: var(--gutter); bottom: 22px; display: inline-flex; align-items: center; gap: 8px; color: var(--cream-300); text-decoration: none; font-size: .8125rem; text-transform: uppercase; min-height: 44px; opacity: .8; }
  .hero__cue svg { width: 16px; animation: cue 2.4s var(--ease) infinite; }
  @keyframes cue { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(5px); } }
  @media (max-width: 1099px) { .hero__inner { grid-template-columns: 1fr; } .hero__block { max-width: 420px; } .hero__cue { display: none; } }
  @media (max-width: 767px) {
    .hero { align-items: stretch; }
    .hero__media { inset: 0 0 auto; height: 60svh; -webkit-mask-image: linear-gradient(#000 62%, transparent); mask-image: linear-gradient(#000 62%, transparent); }
    .hero__media img { object-position: 77% 58%; }
    .hero__shade { background: linear-gradient(180deg, rgb(6 8 12 / .5) 0%, rgb(6 8 12 / 0) 22%); }
    .hero__inner { align-content: end; padding-top: 46svh; padding-bottom: 40px; gap: 28px; }
    .hero h1 { font-size: clamp(2.6rem, 12.5vw, 4rem); }
    .hero__copy { gap: 20px; }
    .hero__block { display: none; }
  }

  /* ---------- clay sections ---------- */
  .clay { position: relative; }
  .cs { position: relative; min-height: 100svh; display: flex; align-items: center; }
  .cs__in { padding-block: calc(var(--nav-h) + 40px) 72px; }
  .cs__card { display: grid; gap: clamp(24px, 2.6vw, 36px); }
  .cs--L .cs__card { width: min(100%, 64%); }
  .cs--R .cs__card { width: min(100%, 66%); margin-left: auto; }
  .cs h2 { font-size: clamp(2.3rem, 4.6vw, 4.6rem); }

  .s0__row { display: grid; grid-template-columns: 1.35fr 1fr; gap: 24px; align-items: end; }
  .s0__tb { border-color: rgb(240 225 206 / .2); }

  .s1__row { display: grid; grid-template-columns: 1.3fr 1fr; gap: 32px; align-items: start; }
  .register { list-style: none; margin: 0; padding: 0; border-top: var(--hair); }
  .register li { display: grid; grid-template-columns: 56px 1fr; column-gap: 12px; padding: 14px 0; border-bottom: var(--hair); }
  .register__ref { color: var(--red-300); grid-row: span 2; padding-top: 3px; }
  .register__name { font-weight: 600; }
  .register__note { color: var(--color-text-muted); font-size: var(--t-small); }

  .s2 .chips li { border-color: rgb(26 40 65 / .25); background: rgb(251 248 243 / .4); }

  .offices { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .offices__role { margin-top: 14px; color: var(--color-text-muted); text-transform: uppercase; font-size: var(--t-micro); letter-spacing: .08em; }
  .offices__city { font-family: var(--f-display); font-variation-settings: "wdth" 80, "opsz" 48; font-weight: 700; font-size: 1.6rem; line-height: 1.1; }

  .cs--train .cs__card { width: min(100%, 78%); }
  .s4 { grid-template-columns: 1.25fr .75fr; align-items: center; gap: clamp(32px, 4vw, 64px); }
  .s4__copy { display: grid; gap: 28px; }
  .s4__h { font-size: clamp(2.8rem, 6vw, 6.2rem) !important; }

  .s5__row { display: grid; grid-template-columns: .8fr 1.2fr; gap: 32px; align-items: start; }
  .compare { width: 100%; border-collapse: collapse; font-size: .9688rem; }
  .compare th, .compare td { text-align: left; vertical-align: top; padding: 14px 12px 14px 0; border-bottom: 1px solid rgb(26 40 65 / .18); }
  .compare thead th { font-family: var(--f-mono); font-size: var(--t-micro); font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--navy-400); padding-top: 0; }
  .compare thead th:last-child { color: var(--red-500); }
  .compare tbody th { font-weight: 600; width: 26%; }
  .compare td:nth-child(2) { color: var(--navy-400); width: 32%; }
  .compare td:last-child { font-weight: 600; color: var(--navy-800); }

  .cs:has(.s6) .cs__card { width: 100%; }
  .s6__h { max-width: 15ch; margin-left: auto; width: min(100%, 64%); }
  .tracks { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .track {
    position: relative; display: grid; gap: 6px; height: 100%; padding: 10px 10px 20px; text-decoration: none; color: var(--cream-300);
    background: rgb(19 30 50 / .72); border: 1px solid var(--navy-500); border-radius: 10px;
    transition: transform .3s var(--ease), border-color .3s var(--ease), background-color .3s var(--ease);
  }
  .track:hover { transform: translateY(-2px); border-color: var(--red-400); background: rgb(31 47 76 / .85); }
  .track :global(.slot) { margin-bottom: 10px; }
  .track__ref { color: var(--red-300); padding-inline: 6px; font-size: var(--t-micro); }
  .track__title { font-family: var(--f-display); font-variation-settings: "wdth" 80, "opsz" 32; font-weight: 700; font-size: 1.4rem; line-height: 1.05; padding-inline: 6px; }
  .track__short { color: var(--navy-100); font-size: var(--t-small); padding-inline: 6px; max-width: 36ch; }
  .track__go { position: absolute; right: 18px; bottom: 18px; width: 20px; color: var(--red-300); transition: transform .3s var(--ease); }
  .track:hover .track__go { transform: translate(2px, -2px); }

  .s7__row { display: grid; grid-template-columns: 1.4fr .8fr; gap: 32px; align-items: end; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 28px; }
  .steps li { display: grid; grid-template-columns: 44px 1fr; column-gap: 8px; padding: 18px 0; border-top: var(--hair); }
  .steps__n { color: var(--red-300); grid-row: span 2; font-size: 1.1rem; }
  .steps__t { font-weight: 600; }
  .steps__d { color: var(--color-text-muted); font-size: var(--t-small); }

  .cs:has(.s8) .cs__card { width: min(100%, 70%); }
  .s8 { grid-template-columns: 1.1fr .9fr; align-items: start; }
  .ticks { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .ticks li { position: relative; padding-left: 26px; }
  .ticks li::before { content: ""; position: absolute; left: 2px; top: .62em; width: 12px; height: 2px; background: var(--red-500); }

  .s9__row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .close { display: grid; gap: 14px; align-content: start; padding: 28px; text-decoration: none; color: var(--cream-300); transition: transform .3s var(--ease), border-color .3s; }
  .close:hover { transform: translateY(-2px); border-color: rgb(240 225 206 / .4); }
  .close__t { font-family: var(--f-display); font-variation-settings: "wdth" 75, "opsz" 96; font-weight: 760; font-size: clamp(2rem, 3vw, 2.8rem); line-height: 1; }
  .close__d { color: var(--navy-100); }
  .close .btn { justify-self: start; margin-top: 8px; }
  .s9__mail { font-size: var(--t-small); }
  .s9__mail .link { min-height: 0; }

  /* tablets: content takes the full width, pieces stay on the edge band */
  @media (max-width: 1099px) {
    .cs--L .cs__card, .cs--R .cs__card, .cs--train .cs__card, .cs:has(.s8) .cs__card { width: min(100%, 78%); }
    .s4, .s8 { grid-template-columns: 1fr; }
    .s4__art { max-width: 360px; }
    .tracks { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* phones: pieces live in a band at the top of each section, content sits on glass below it */
  @media (max-width: 767px) {
    .cs { align-items: flex-start; }
    .cs__in { padding-block: 236px 48px; }
