---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import FlutedGlass from '../components/FlutedGlass.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../data/site';
---
<Base og="verify" breadcrumbs={[['Verify a certificate', '/verify']]} title="Verify a certificate" description="Check that a Mechbridge International training or internship certificate is genuine and still valid.">
  <section class="vh" aria-labelledby="vh-h">
    <div class="wrap vh__grid">
      <div class="vh__copy">
        <h1 id="vh-h">Verify a certificate.</h1>
        <p class="lede">Every certificate from Mechbridge International MEP Consultants carries a code like <span class="mono nowrap">MBI-2026-7KQ4XD</span>. Enter it to confirm who it was issued to and whether it is still valid.</p>
        <form class="vform" data-verify novalidate>
          <div class="field">
            <label for="code">Certificate code</label>
            <div class="vform__row">
              <input id="code" name="code" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="MBI-2026-XXXXXX" aria-describedby="code-err" required />
              <button class="btn" type="submit">Check <Arrow /></button>
            </div>
            <p class="err" id="code-err" aria-live="polite"></p>
          </div>
        </form>
        <div class="result" data-result aria-live="polite" hidden></div>
        <p class="body vh__help">Employers can also scan the QR code printed on the certificate. Questions about a certificate: <a class="link" href={`mailto:${site.connect}`}>{site.connect}</a></p>
      </div>
      <FlutedGlass ratio="1 / 1" rib={20} left="MBI" right="Verified" />
    </div>
  </section>
</Base>

<script>
  import { api } from '../lib/api/client';
  import { fmtDate } from '../scripts/postings';
  import { normaliseCode } from '../lib/roles';

  const form = document.querySelector<HTMLFormElement>('[data-verify]')!;
  const input = form.querySelector<HTMLInputElement>('#code')!;
  const err = form.querySelector<HTMLElement>('#code-err')!;
  const out = document.querySelector<HTMLElement>('[data-result]')!;
  const btn = form.querySelector<HTMLButtonElement>('button')!;

  const row = (k: string, v: string) => {
    const d = document.createElement('div'); d.className = 'tblock__row';
    const a = document.createElement('span'); a.className = 'tblock__k'; a.textContent = k;
    const b = document.createElement('span'); b.className = 'tblock__v'; b.textContent = v;
    d.append(a, b); return d;
  };

  async function check(raw: string) {
    const code = normaliseCode(raw);
    err.textContent = '';
    input.removeAttribute('aria-invalid');
    if (!/^MBI-\d{4}-[A-Z0-9]{6}$/.test(code)) {
      err.textContent = 'Enter the full code as printed, for example MBI-2026-7KQ4XD.';
      input.setAttribute('aria-invalid', 'true'); input.focus(); return;
    }
    btn.setAttribute('aria-busy', 'true');
    try {
      const r = await api.verify(code);
      out.hidden = false; out.replaceChildren(); out.className = 'result';
      const h = document.createElement('h2'); h.className = 'result__h';
      if (!r.found) {
        out.classList.add('result--none');
        h.textContent = 'No certificate matches this code.';
        const p = document.createElement('p'); p.className = 'body';
        p.textContent = 'Check the code for typing mistakes. If it is correct, the certificate was not issued by Mechbridge International.';
        out.append(h, p);
      } else {
        const valid = r.status === 'valid';
        out.classList.add(valid ? 'result--ok' : 'result--revoked');
        h.textContent = valid ? 'Valid certificate' : 'This certificate has been revoked';
        const tb = document.createElement('div'); tb.className = 'tblock';
        tb.append(
          row('Code', r.code!), row('Issued to', r.holder_name!),
          row('Programme', r.programme === 'internship' ? 'Internship' : 'Professional training'),
          row('Title', r.title!),
          ...(r.period_from || r.period_to ? [row('Period', [r.period_from, r.period_to].filter(Boolean).map((d) => fmtDate(d!)).join(' to '))] : []),
          row('Issued on', fmtDate(r.issue_date!)),
          row('Status', valid ? 'Valid' : 'Revoked'),
        );
        out.append(h, tb);
      }
      const url = new URL(location.href); url.searchParams.set('code', code); history.replaceState(null, '', url);
    } catch (e) {
      out.hidden = false; out.className = 'result result--none';
      out.textContent = 'The check could not run right now. Try again in a minute.';
    } finally { btn.removeAttribute('aria-busy'); }
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); check(input.value); });
  const q = new URLSearchParams(location.search).get('code');
  if (q) { input.value = normaliseCode(q); check(q); }
</script>

<style>
  .vh { background: var(--navy-800); min-height: 100svh; padding: calc(var(--nav-h) + clamp(40px, 6vw, 88px)) 0 clamp(64px, 8vw, 120px); display: flex; align-items: center; }
  .vh__grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: clamp(40px, 6vw, 112px); align-items: center; }
  .vh__copy { display: grid; gap: 28px; }
  .vform__row { display: flex; gap: 10px; }
  .vform__row input { flex: 1; font-family: var(--f-mono); letter-spacing: .06em; text-transform: uppercase; }
  .vh__help .link { min-height: 0; }
  .result { display: grid; gap: 18px; padding: 24px; border-radius: 14px; border: 1px solid var(--navy-500); background: var(--navy-700); }
  :global(.result__h) { font-size: clamp(1.8rem, 3vw, 2.6rem); }
  :global(.result--ok) { border-color: var(--green-500); }
  :global(.result--ok .result__h) { color: #9ed3a9; }
  :global(.result--revoked) { border-color: var(--red-400); }
  :global(.result--revoked .result__h) { color: var(--red-200); }
  :global(.result--none) { border-style: dashed; }
  @media (max-width: 899px) { .vh__grid { grid-template-columns: 1fr; } .vh__grid > :global(.fluted) { display: none; } }
  @media (max-width: 479px) { .vform__row { flex-direction: column; } .vform__row .btn { width: 100%; } }
</style>
