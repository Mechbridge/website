# Production (VPS). Copy to /etc/mechbridge.env (systemd) or export before `npm start`.
HOST=127.0.0.1
PORT=4321
DATA_DIR=/var/lib/mechbridge            # SQLite database + uploads/ (CVs). Back this up.
PUBLIC_SITE_URL=https://mechbridgegroup.com

# Optional: email alerts for new leads. Leads are always saved in the admin portal either way.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mechbridge website <no-reply@mechbridgegroup.com>"
LEAD_NOTIFY_TO=connect@mechbridgegroup.com
SUPPORT_NOTIFY_TO=support@mechbridgegroup.com
CAREERS_NOTIFY_TO=careers@mechbridgegroup.com
INTERN_NOTIFY_TO=intern@mechbridgegroup.com
